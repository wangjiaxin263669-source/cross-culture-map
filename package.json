{
  "name": "cross-culture-map",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node scripts/kill-api-port.mjs && concurrently -k false -n api,web -c cyan,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "build:knowledge": "node server/scripts/build-knowledge.mjs",
    "predeploy": "node scripts/predeploy.mjs",
    "deploy:final": "node scripts/predeploy.mjs && npm run build",
    "start": "node scripts/kill-api-port.mjs && npm run build && npm run start:prod",
    "start:prod": "node scripts/start-prod.mjs",
    "start:server": "node server/index.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "guardian": "node scripts/culture-link-guardian-auto.mjs",
    "guardian:check": "node scripts/culture-link-guardian.mjs",
    "guardian:audit": "node scripts/audit-all-markets.mjs",
    "guardian:validate-urls": "node scripts/validate-curated-links.mjs",
    "site-health": "node scripts/site-health-guardian.mjs",
    "site-health:fix": "node scripts/site-health-guardian.mjs --apply-safe-fixes",
    "site-health:ci": "node scripts/site-health-guardian.mjs --ci",
    "site-health:validate": "node scripts/validate-site-health-guardian.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@netlify/blobs": "^10.7.8",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "iconv-lite": "^0.7.2",
    "jsonwebtoken": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "raw-body": "^3.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-globe.gl": "^2.38.0",
    "recharts": "^3.8.1",
    "serverless-http": "^3.2.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.49.1",
    "vite": "^8.0.12"
  }
}
