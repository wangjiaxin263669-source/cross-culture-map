# 从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 可选：模型（默认 deepseek-chat；深度推理可用 deepseek-reasoner）
# DEEPSEEK_MODEL=deepseek-chat

# 可选：API 地址（一般无需修改）
# DEEPSEEK_API_BASE=https://api.deepseek.com

# 服务端口（本地默认 3001；云平台会注入 PORT）
# PORT=3001

# 可选：自定义 SKILL 路径（默认读取桌面 cross-cultural-research/SKILL.md 或项目内置）
# SKILL_PATH=C:/Users/ASUS/Desktop/cross-cultural-research/SKILL.md

# 可选：Serper 搜索 API（启用小红书 site: 与全网语料检索）https://serper.dev
# SERPER_API_KEY=your_serper_api_key
