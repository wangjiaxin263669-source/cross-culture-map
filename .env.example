# 从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 可选：模型（默认 deepseek-chat；深度推理可用 deepseek-reasoner）
# DEEPSEEK_MODEL=deepseek-chat

# 可选：API 地址（一般无需修改）
# DEEPSEEK_API_BASE=https://api.deepseek.com

# 服务端口（本地默认 3001；云平台会注入 PORT）
# PORT=3001

# 可选：自定义 SKILL 路径（默认读取桌面 cross-cultural-research/SKILL.md 或项目内置）
# SKILL_PATH=C:/Users/ASUS/Desktop/cross-cultural-research/SKILL.md

# 可选：Serper 搜索 API（启用小红书 site: 与全网语料检索）https://serper.dev
# SERPER_API_KEY=your_serper_api_key

# --- 开放平台 · 内容语料（模拟调研）---

# Just One API：小红书笔记搜索 + 微博关键词（推荐，非官方但适合 UGC 语料）
# 文档 https://docs.justoneapi.com/zh/api/xiaohongshu-rednote/note-search-v3
# JUSTONE_API_TOKEN=your_justone_token
# JUSTONE_API_BASE=https://api.justoneapi.com

# 小红书官方 ARK 开放平台（商家 OAuth，商品/订单/素材；笔记检索请用 JUSTONE）
# 控制台 https://open.xiaohongshu.com
# XHS_ARK_APP_ID=
# XHS_ARK_APP_SECRET=
# XHS_ARK_REDIRECT_URI=http://localhost:3001/api/open-platform/xhs/callback
# 线上 Netlify 可直填 token（本地 OAuth 后复制）：
# XHS_ARK_ACCESS_TOKEN=

# 微博开放平台 OAuth https://open.weibo.com
# WEIBO_APP_KEY=
# WEIBO_APP_SECRET=
# WEIBO_REDIRECT_URI=http://localhost:3001/api/open-platform/weibo/callback
# WEIBO_ACCESS_TOKEN=

# 本地开发务必用文件存储（不要用 blobs）
# STORAGE_BACKEND=file

# --- 用户账号与历史记录 ---

# JWT 签名密钥（生产环境务必改为随机长字符串）
# JWT_SECRET=your_random_secret_here
# JWT_EXPIRES=30d

# 前端地址（微信登录回调后跳转，带 token）
# FRONTEND_URL=http://localhost:5173
# VITE_APP_URL=http://localhost:5173

# 微信开放平台 · 网站应用扫码登录 https://open.weixin.qq.com
# WECHAT_OPEN_APP_ID=
# WECHAT_OPEN_APP_SECRET=
# 回调须与微信后台一致，本地默认：
# WECHAT_REDIRECT_URI=http://localhost:3001/api/auth/wechat/callback

# --- 手机号验证码登录（推荐 UniSMS 真实短信）---
# 注册 https://unisms.apistd.com → 控制台创建签名 → 复制 AccessKey ID
# 生产环境在 Netlify 后台填下面三项（勿提交到 Git）：
# SMS_PROVIDER=unisms
# UNISMS_ACCESS_KEY_ID=你的AccessKey
# UNISMS_SIGNATURE=跨文化平台
# UNISMS_TEMPLATE_ID=   # 可选，审核通过的模板 ID；留空则用正文直发

# 本地无 UniSMS 时可用 mock（验证码显示在页面）
# SMS_PROVIDER=mock
# SMS_EXPOSE_DEV_CODE=true

# 阿里云短信（模板变量名须为 code）
# SMS_PROVIDER=aliyun
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=

# 自建 HTTP 网关（POST JSON: { phone, code, template }）
# SMS_PROVIDER=http
# SMS_WEBHOOK_URL=https://your-sms-gateway.example/send

# --- 账户余额与充值（用户付您微信，您自行充值 DeepSeek API）---

# 每次扣费（单位：分，10 = 0.1 元）
# 对话（DeepSeek 助手）每次扣费，默认 2 = ¥0.02
# WALLET_CHAT_COST_CENTS=2
# WALLET_REPORT_COST_CENTS=10
# WALLET_SIM_PERSONAS_COST_CENTS=10
# WALLET_SIM_INTERVIEW_COST_CENTS=10
# WALLET_SIM_REPORT_COST_CENTS=10

# 新用户注册赠送（分），默认 50 = 0.5 元
# NEW_USER_BONUS_CENTS=50

# 每日登录赠送（分），默认 5 = 0.05 元；累计上限 50 = 0.5 元
# DAILY_LOGIN_BONUS_CENTS=5
# DAILY_LOGIN_BONUS_CAP_CENTS=70

# 支付：mock=本地开发模拟到账 | wechat_qr=微信收款码（推荐盈利）| zpay=易支付
# PAYMENT_PROVIDER=mock
# 线上盈利请改为 wechat_qr，并上传 public/wechat-pay-qr.png
# PAYMENT_PROVIDER=wechat_qr
# WECHAT_PAY_QR_URL=/wechat-pay-qr.png
# WECHAT_PAY_OWNER_NAME=您的昵称或店名

# 管理员核实微信到账后入账（scripts/confirm-recharge.ps1 使用）
# RECHARGE_ADMIN_SECRET=随机长字符串

# API_PUBLIC_URL=http://localhost:3001
# PAYMENT_RETURN_URL=http://localhost:5173/?recharge=success

# 易支付（可选，自动回调，需商户号）
# ZPAY_PID=你的商户ID
# ZPAY_KEY=你的商户密钥
# ZPAY_API_BASE=https://你的支付域名
