# 复制为 .env 后填写，用于 VPS / Docker 最终版上线

NODE_ENV=production
PORT=3001

DEEPSEEK_API_KEY=sk-你的密钥

# 必填：随机长字符串（可用 PowerShell: [guid]::NewGuid().ToString('N')）
JWT_SECRET=请替换为至少32位随机字符串
JWT_EXPIRES=30d

# 你的公网访问地址（不要末尾斜杠）
FRONTEND_URL=https://你的域名
API_PUBLIC_URL=https://你的域名
PAYMENT_RETURN_URL=https://你的域名/?recharge=success

# 充值：正式上线用 zpay；仅自己测试可用 mock
PAYMENT_PROVIDER=zpay
ZPAY_PID=
ZPAY_KEY=
ZPAY_API_BASE=

# 扣费单价（分），10 = 0.1 元/次
WALLET_CHAT_COST_CENTS=10
WALLET_REPORT_COST_CENTS=10
WALLET_SIM_PERSONAS_COST_CENTS=10
WALLET_SIM_INTERVIEW_COST_CENTS=10
WALLET_SIM_REPORT_COST_CENTS=10
NEW_USER_BONUS_CENTS=50

# 可选：微信登录
# WECHAT_OPEN_APP_ID=
# WECHAT_OPEN_APP_SECRET=
# WECHAT_REDIRECT_URI=https://你的域名/api/auth/wechat/callback
